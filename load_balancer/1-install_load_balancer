#!/usr/bin/env bash
# Installs and configures HAProxy on lb-01 to balance traffic between web-01 and web-02

apt-get -y update
apt-get -y install haproxy

cat << 'CONFIG' > /etc/haproxy/haproxy.cfg
global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 5000
    timeout client  50000
    timeout server  50000

frontend alu-frontend
    bind *:80
    mode http
    default_backend alu-backend

backend alu-backend
    balance roundrobin
    server 7272-web-01 18.135.27.194:80 check
    server 7272-web-02 18.175.237.53:80 check
CONFIG

echo "ENABLED=1" > /etc/default/haproxy

service haproxy restart
