#!/usr/bin/env bash
# Configures Nginx to redirect /redirect_me to another URL with a 301 status

apt-get -y update
apt-get -y install nginx

echo "Hello World!" > /var/www/html/index.html

# Configure 301 redirect in default Nginx site configuration
sed -i 's|server_name _;|server_name _;\n\trewrite ^/redirect_me https://youtube.com permanent;|' /etc/nginx/sites-available/default

service nginx restart
